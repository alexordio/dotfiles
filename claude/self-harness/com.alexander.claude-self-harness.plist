<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ponytail: paths hardcoded to this one Mac by design — this whole system
     is scoped to a single machine, not meant to roam. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexander.claude-self-harness</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alexander/dotfiles/claude/self-harness/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/alexander/.claude/self-harness/run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexander/.claude/self-harness/run.err.log</string>
</dict>
</plist>
